NEXT_PUBLIC_SUPABASE_URL=https://migtjpveavdrkbtonelf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kEU-L4hoZqAIs3g2z9ya2Q_nOVWk8tm
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — card and mobile-money checkout. Without these, members pay by
# bank transfer / mobile money to the details in Editor → Settings and
# WTC Accra finance confirms the payment in Administration → Payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Server-only. Required by the Paystack callback to record a verified payment,
# and by /api/internal/process-notifications to send queued email/push.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only random salt used when hashing anonymous client identifiers for rate limiting.
THROTTLE_SALT=
ANTHROPIC_API_KEY=
# Optional preferred translation provider. If unset, automatic translation can fall back to Anthropic when configured.
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_TRANSLATION_MODEL=claude-3-5-haiku-latest

# Outbound email. Use the same SMTP mailbox configured under
# Supabase -> Project Settings -> Authentication -> SMTP Settings, so platform
# mail and Supabase auth mail leave from one sender. Without these, emails stay
# queued in Administration -> Emails and are never lost.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="WTC Accra Hub <membership@wtcaccra.com>"
EMAIL_REPLY_TO=membership@wtcaccra.com
# Required before marketing, newsletter or waitlist emails can be sent.
# Use a long random server-only value. It signs one-click unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=

# Phone push notifications (drains public.outbound_pushes via Web Push).
# Generate a keypair once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:membership@wtcaccra.com"

# The notification worker now verifies the Supabase Vault wake-up secret by hash,
# so no matching Vercel environment variable is required for that wake-up path.
